# MLVerse Environment Configuration Template
# Copy to .env for local runtime overrides

# Application
APP_NAME=MLVerse
APP_ENV=production
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=mlverse-insecure-dev-secret-key-change-in-production

# Raw Datasets Location (Strictly Read-Only)
RAW_DATA_DIR=D:/customer churn prediction

# SQLite Database Location
DATABASE_URL=sqlite:///./mlverse.db

# Model Artifacts Directory
ARTIFACTS_DIR=./artifacts

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
